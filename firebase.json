{
  "hosting": {
    "target": "guide",
    "public": "hosting-public",
    "headers": [
      {
        "source": "/v4/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          }
        ]
      }
    ],
    "predeploy": [
      "node tools/prepare-hosting.mjs"
    ],
    "rewrites": [
      {
        "function": {
          "functionId": "submitMoveInSurvey",
          "region": "asia-northeast1"
        },
        "source": "/api/move-in-survey"
      }
    ]
  },
  "functions": [
    {
      "codebase": "guide-survey",
      "source": "functions"
    }
  ]
}
