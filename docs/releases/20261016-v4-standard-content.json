      "content": "便座・ふたの取り扱い"
    },
    {
      "action_url": "",
      "variant_key": "v4_toilet_washlet_standard",
      "block_type": "text",
      "alt_text": "",
      "image_url": "",
      "section_key": "toilet",
      "block_order": 80,
