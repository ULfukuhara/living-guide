      "action_label": "",
      "style_key": "default",
      "enabled": true,
      "content": "便座やふたに強い衝撃を与えたり、無理に取り外したりしないでください。"
    },
    {
      "block_id": "toilet_v4_toilet_washlet_standard_009",
      "section_key": "toilet",
      "variant_key": "v4_toilet_washlet_standard",
      "block_order": 82,
      "block_type": "heading",
      "content": "温水洗浄便座の使い方・お手入れ",
