      "action_url": "",
      "style_key": "default",
      "enabled": true
    },
    {
      "block_id": "toilet_v4_toilet_washlet_standard_010",
      "section_key": "toilet",
      "variant_key": "v4_toilet_washlet_standard",
      "block_order": 84,
      "block_type": "text",
      "content": "便座やノズルは定期的に清掃してください。清掃方法や使える洗剤は、機種の取扱説明書をご確認ください。\n洗浄機能が使えないなどの不具合は、状態の写真を添えて管理会社へご連絡ください。",
      "image_url": "",
      "alt_text": "",
      "action_label": "",
      "action_url": "",
      "style_key": "default",
      "enabled": true
    },
    {
