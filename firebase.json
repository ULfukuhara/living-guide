{
  "hosting": {
    "target": "guide",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "_removed_candidates/**",
      "**/.*/**",
      "AGENTS.md",
      "CLAUDE.md",
      "**/*.log"
    ],
    "headers": [
      {
        "source": "/v4/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          }
        ]
      }
    ]
  }
}
